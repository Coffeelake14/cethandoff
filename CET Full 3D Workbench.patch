+/* The two modes share controls and content. These materials only apply in mission mode. */
+.workbench-heading, .instrument-window, .score-dial, .workbench-intro, .stage-assembly { display: none; }
+body[data-mode="command"] .simple-intro { display: none; }
+body[data-mode="command"] .workbench-intro { display: block; }
+
+body[data-mode="command"] {
+  --site-bg: #141814;
+  --site-surface: #252a24;
+  --site-fg: #f3eee1;
+  --site-muted: #c5c5b8;
+  --site-border: #52584c;
+  --site-accent: #b6dfc8;
+  --site-on-accent: #15241a;
+  --site-radius: 3px;
+  --accent-deep: #b9e2cd;
+  --accent-soft: #2e4436;
+  --accent-glow: #acdfbc30;
+  --ok: #99ddaf;
+  --ok-soft: #233a29;
+  --warn: #f0b281;
+  --warn-soft: #433024;
+  --bad: #ffad96;
+  --bad-soft: #492b24;
+  --info: #b6d6ce;
+  --panel-edge: #0b0f0c;
+  --shadow-sm: 0 3px var(--panel-edge), 0 5px #45493b;
+  --shadow-md: 0 4px var(--panel-edge), 0 14px 25px #0005;
+  --shadow-lg: 0 11px 27px #0008;
+  --gap: 18px;
+  color-scheme: dark;
+}
+
+body[data-mode="command"] .bg { background: radial-gradient(ellipse at 34% 0%, #454036 0%, transparent 59%), #121513; }
+body[data-mode="command"][data-view="command"] .bg { background-color: var(--command-bg); }
+body[data-mode="command"] .bg .orb { display: none; }
+body[data-mode="command"] .header { background: #141715f5; border-color: #4a4940; }
+body[data-mode="command"] .brand .logo { border: 1px solid #595748; background: #292e26; color: #e8ddbf; box-shadow: inset 0 1px #716a56; }
+body[data-mode="command"] .command-return { color: var(--site-fg); border-color: var(--site-border); background: #282d25; }
+body[data-mode="simple"] .command-return { color: var(--site-fg); border-color: var(--site-border); background: var(--site-surface); }
+
+body[data-mode="command"] .tabnav {
+  display: flex; position: fixed; z-index: 51; top: 10px; left: 50%; transform: translateX(-50%);
+  width: max-content; max-width: calc(100% - 18px); gap: 4px; padding: 4px; margin: 0;
+  border: 1px solid #515449; border-radius: 3px; background: #20251e;
+  box-shadow: inset 0 1px #616455, 0 3px #0a0d0a;
+}
+body[data-mode="command"] .tabnav .tab {
+  min-height: 32px; padding: 5px 11px; color: #d0d3c4; border-radius: 2px; white-space: nowrap;
+  border: 1px solid #414739; background: #2a3027; box-shadow: inset 0 1px #858b7040, 0 2px #10150f;
+  font-size: 12px;
+}
+body[data-mode="command"] .tabnav .tab[aria-selected="true"] {
+  color: #24281e; border-color: #dfd5b6; background: #e5daaf; box-shadow: inset 0 -2px #b3a67b, 0 2px #151811;
+}
+
+@media (max-width: 820px) {
+  body[data-mode="command"] .tabnav { position: relative; z-index: auto; top: auto; left: auto; transform: none; margin: 0 auto 14px; }
+  body[data-mode="command"] .tabnav .tab { padding-inline: 7px; min-height: 34px; }
+  body[data-mode="command"] .tabnav svg { width: 14px; height: 14px; }
+}
+
+body[data-mode="command"] :is(.view-reading,.view-estimator) { --workbench-sheet: #202720; }
+body[data-mode="command"] .workbench-heading,
+body[data-mode="command"] .lab-hero {
+  position: relative; display: grid; grid-template-columns: minmax(0,1fr) minmax(155px,255px);
+  align-items: center; min-height: 140px; margin-bottom: 18px; padding: 13px 20px;
+  border: 1px solid #787363; border-radius: 3px;
+  background: repeating-linear-gradient(0deg,#d8c8a509 0 1px,transparent 1px 4px), linear-gradient(125deg,#454438,#292f26 56%,#1e241e);
+  box-shadow: inset 0 1px #f0df9b40, inset 0 -3px #161a14, 0 5px #131913, 0 7px #545748, 0 14px 23px #080a0780;
+}
+body[data-mode="command"] .workbench-heading h2,
+body[data-mode="command"] .lab-hero h2 {
+  margin: 0; color: #f2edda; font-size: clamp(26px,3.25vw,44px); line-height: 1.16; text-wrap: balance;
+  text-shadow: 0 3px #121811; letter-spacing: .025em;
+}
+body[data-mode="command"] .lab-hero .eyebrow { background: #252a20; color: #d9d1af; border-color: #69664f; }
+body[data-mode="command"] .lab-hero p { color: #dedbc9; }
+body[data-mode="command"] .lab-hero::after, body[data-mode="command"] .lh-facts { display: none; }
+
+body[data-mode="command"] .instrument-window {
+  position: relative; display: block; min-width: 0; height: 148px; overflow: hidden; perspective: 590px;
+  background: radial-gradient(ellipse at 50% 55%,#9ecaaa24,transparent 66%);
+}
+.instrument-scene {
+  position: absolute; inset: 0; transform-style: preserve-3d;
+  transform: rotateX(calc(-29deg + var(--device-pitch,0deg))) rotateY(calc(-31deg + var(--device-yaw,0deg)));
+  transition: transform .38s cubic-bezier(.22,.8,.2,1);
+}
+.instrument-slab {
+  position: absolute; top: 50%; left: 50%; width: var(--width); height: var(--height);
+  transform: translate(-50%,calc(-50% + var(--level))); transform-style: preserve-3d;
+  animation: seat-layer .64s cubic-bezier(.2,.8,.2,1) both;
+}
+.instrument-slab:nth-child(2) { animation-delay: .06s; }
+.instrument-slab:nth-child(3) { animation-delay: .12s; }
+.instrument-slab:nth-child(4) { animation-delay: .18s; }
+.instrument-face { display: block; position: absolute; border: 1px solid #797a5f; }
+.instrument-face.face-front {
+  inset: 0; transform: translateZ(calc(var(--depth) / 2));
+  background: repeating-linear-gradient(90deg,#81866e40 0 2px,transparent 2px 10px),linear-gradient(#454a3b,#1c241b);
+}
+.instrument-slab:nth-child(2) .face-front { border-color: #bc9568; background: linear-gradient(#986745,#573820); }
+.instrument-face.face-side { left: 50%; height: 100%; width: var(--depth); background: #242f23; transform: translateX(calc((var(--width) - var(--depth)) / 2)) rotateY(90deg); }
+.instrument-face.face-top { top: 50%; width: 100%; height: var(--depth); background: linear-gradient(130deg,#6e775f,#3a4937); transform: translateY(calc((var(--height) + var(--depth)) / -2)) rotateX(90deg); }
+.instrument-slab:last-of-type .face-top { background: radial-gradient(ellipse,#a4d2b464,#3b6856); }
+.instrument-lens {
+  position: absolute; top: calc(50% - 33px); left: 50%; width: 54px; height: 54px; border-radius: 50%;
+  transform: translate(-50%,-50%) rotateX(59deg) translateZ(11px);
+  border: 2px solid #b1ddc4; outline: 4px solid #19261d; box-shadow: 0 0 0 5px #69917d, inset 0 0 15px #7ec7ab40;
+  background: conic-gradient(transparent 5%,#a2d2b560 22%,transparent 25%),radial-gradient(#9adbab55,#294d42 54%,#202f25 56%);
+  animation: lens-align .78s ease-out both;
+}
+[data-instrument="optics"] .instrument-lens { width: 66px; height: 66px; transform: translate(-50%,-50%) rotateX(59deg) translateZ(17px); }
+[data-instrument="calibration"] .instrument-lens { border-style: dashed; width: 49px; height: 49px; }
+@keyframes seat-layer { from { transform: translate(-50%,calc(-50% + var(--level) - 16px)) translateZ(18px); opacity: 0; } }
+@keyframes lens-align { from { opacity: 0; filter: brightness(2); } }
+
